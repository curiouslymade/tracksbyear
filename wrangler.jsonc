// Cloudflare Worker settings. The site is static files only: there is no Worker script.
// "name" must be the same as the Worker name in the Cloudflare dashboard.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tracksbyear",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Each unknown path gets index.html. The app has one page.
    "not_found_handling": "single-page-application"
  },
  // The site is only on its own address, not on workers.dev or on preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tracksbyear.curiouslymade.dev", "custom_domain": true }
  ]
}
