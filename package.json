{
  "name": "tracksbyear",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "check": "node scripts/check-dist.mjs",
    "preview": "wrangler dev",
    "test": "vitest run && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/make-images.mjs",
    "protect-repo": "node scripts/protect-repo.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}
